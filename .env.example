APP_ENV=development
APP_NAME=public-data-agent
LOG_LEVEL=INFO
LOG_FORMAT=json

DATABASE_URL=postgresql+psycopg://app:app@localhost:55432/public_data_agent
READONLY_DATABASE_URL=postgresql+psycopg://app_readonly:app_readonly@localhost:55432/public_data_agent

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_THINKING_MODE=disabled
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_RATE_LIMIT_QPS=2
LLM_RATE_LIMIT_BURST=5
LLM_MAX_TOKENS=2048

EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_VERSION=qwen3-embedding-4b-mrl1024-query-instruct-v1
EMBEDDING_DIM=1024
EMBEDDING_QUERY_INSTRUCTION=Given a Chinese government data question, retrieve relevant policy passages, statistical tables, metrics, fields, and SQL metadata that answer the query.
EMBEDDING_BATCH_SIZE=8
EMBEDDING_PROVIDER=remote_http
EMBEDDING_MAX_RETRIES=1
EMBEDDING_NORMALIZE=true
EMBEDDING_DEVICE=
EMBEDDING_REMOTE_URL=http://127.0.0.1:18080/v1/embeddings
EMBEDDING_REMOTE_API_KEY=
EMBEDDING_REMOTE_API_FORMAT=openai
EMBEDDING_REMOTE_TRUST_ENV=false
EMBEDDING_REQUEST_TIMEOUT_SECONDS=120

FILE_STORAGE_ROOT=data/uploads

JWT_SECRET_KEY=replace_with_random_secret
JWT_EXPIRE_MINUTES=1440
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SQL_MAX_ROWS=200
SQL_DEFAULT_LIMIT=100
SQL_TIMEOUT_SECONDS=5
SQL_ALLOWED_SCHEMA=reporting
SQL_READONLY_SEARCH_PATH=reporting

WORKER_ID=local-worker-1
JOB_POLL_INTERVAL_SECONDS=2
JOB_HEARTBEAT_INTERVAL_SECONDS=10
JOB_HEARTBEAT_TIMEOUT_SECONDS=120
JOB_MAX_RETRIES=2

OCR_ENABLED=true
OCR_LANG=ch
OCR_ENGINE=rapidocr
OCR_RENDER_DPI=180
OCR_MIN_TEXT_LENGTH=20
OCR_AGENT_REFINE_ENABLED=false
PDF_EXTRACTOR_MODE=layout
PDF_AGENT_REFINE_ENABLED=false
PDF_TABLE_EXTRACTION_ENABLED=true

DEV_SEED_ADMIN_USERNAME=admin
DEV_SEED_ADMIN_PASSWORD=change_me_admin
DEV_SEED_DEMO_USERNAME=demo
DEV_SEED_DEMO_PASSWORD=change_me_demo
